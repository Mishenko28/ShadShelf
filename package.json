{
	"name": "ShadShelf",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "electron/dist/main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"generate": "node src/scripts/generate.ts",
		"electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
		"electron:build": "tsc -p tsconfig.electron.json && vite build && electron-builder"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"framer-motion": "^13.4.0",
		"lucide-react": "^1.46.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.4.0",
		"shadcn": "^4.21.0",
		"tailwind-scrollbar-hide": "^4.0.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@eslint/js": "^10",
		"@types/node": "^20.19.43",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^6",
		"concurrently": "^10.0.5",
		"electron": "^44.4.1",
		"eslint": "^10",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"react-syntax-highlighter": "^16.1.1",
		"typescript": "~6",
		"typescript-eslint": "^8",
		"vite": "^8",
		"wait-on": "^9.1.0"
	}
}
